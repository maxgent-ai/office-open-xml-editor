---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { Code } from 'astro:components';
import { codeThemes } from '../../lib/code-theme';
import { announcements, formatAnnouncementDate, inlineSegments, type Announcement } from '../../lib/announcements';

export function getStaticPaths() {
  return announcements.map((announcement) => ({
    params: { slug: announcement.slug },
    props: { announcement },
  }));
}

const { announcement } = Astro.props as { announcement: Announcement };
const sectionId = (title: string): string => title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');
---
<Base
  title={`${announcement.title} — @silurus/ooxml`}
  description={announcement.summary}
  canonicalPath={`/announcements/${announcement.slug}/`}
>
  <Nav active="announcements" />
  <main>
    <header class="article-hero">
      <div class="wrap article-head">
        <a class="article-back" href="/announcements">← All announcements</a>
        <div class="article-meta">
          <time datetime={announcement.date}>{formatAnnouncementDate(announcement.date)}</time>
          <span>{announcement.label}</span>
          {announcement.version && <span class="article-version">{announcement.version}</span>}
        </div>
        <h1>{announcement.title}</h1>
        <p class="article-summary">{announcement.summary}</p>
        {announcement.image && (
          <figure class="article-image">
            <img
              src={announcement.image.src}
              alt={announcement.image.alt}
              width="2400"
              height="930"
              loading="eager"
              decoding="async"
            />
            {announcement.image.caption && <figcaption>{announcement.image.caption}</figcaption>}
          </figure>
        )}
      </div>
    </header>

    <article class="wrap article-grid">
      <aside class="article-toc">
        <span>Table of contents</span>
        <nav aria-label="Table of contents">
          <ol>
            {announcement.sections.map((section) => (
              <li><a href={`#${sectionId(section.title)}`}>{section.title}</a></li>
            ))}
          </ol>
        </nav>
      </aside>
      <div class="article-body">
        {announcement.sections.map((section) => (
          <section id={sectionId(section.title)} class:list={{ 'article-summary-block': section.kind === 'summary' }}>
            <h2>{section.title}</h2>
            {(section.modules?.length || section.rationale) && (
              <dl class="article-section-meta">
                {section.modules?.length && <><dt>Affected modules</dt><dd class="article-module-list">{section.modules.map((module, index) => <span class="article-module"><code>{module}</code>{index < (section.modules?.length ?? 0) - 1 && ','}</span>)}</dd></>}
                {section.rationale && <><dt>Why</dt><dd>{section.rationale}</dd></>}
              </dl>
            )}
            {section.paragraphs.map((paragraph) => <p>{inlineSegments(paragraph).map(({ text, code }) => code ? <code>{text}</code> : text)}</p>)}
            {section.bullets && <ul>{section.bullets.map((bullet) => <li>{inlineSegments(bullet).map(({ text, code }) => code ? <code>{text}</code> : text)}</li>)}</ul>}
            {section.examples?.map((example) => (
              <div class="article-example">
                <h3>{example.title}</h3>
                <Code code={example.code} lang="ts" themes={codeThemes} defaultColor={false} />
              </div>
            ))}
          </section>
        ))}
        <div class="article-next">
          <span>Questions about the change?</span>
          <a href="https://github.com/yukiyokotani/office-open-xml-viewer/discussions">Start a GitHub discussion &#x2197;&#xFE0E;</a>
        </div>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>

<style>
  .article-hero { padding: 58px 0 72px; border-bottom: 1px solid var(--border); }
  .article-head { max-width: 980px; }
  .article-back { color: var(--text-faint); font-size: 13px; }
  .article-back:hover { color: var(--text); }
  .article-meta { display: flex; gap: 12px; margin-top: 72px; font: 11px var(--mono); text-transform: uppercase; letter-spacing: .09em; color: var(--text-faint); }
  .article-version { color: var(--accent); }
  h1 { margin-top: 18px; max-width: 16ch; font-size: clamp(42px, 7vw, 78px); letter-spacing: -.055em; }
  .article-summary { max-width: 70ch; margin: 28px 0 0; color: var(--text-dim); font-size: 19px; }
  .article-image { margin: 42px 0 -20px; }
  .article-image img { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-elev); }
  .article-image figcaption { margin-top: 10px; color: var(--text-faint); font: 12px/1.55 var(--mono); }
  .article-grid { display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 80px; padding-top: 72px; padding-bottom: 120px; }
  aside, .article-body { min-width: 0; overflow-wrap: anywhere; }
  .article-toc { position: sticky; top: 92px; align-self: start; padding-top: 8px; }
  .article-toc span { font: 11px var(--mono); text-transform: uppercase; letter-spacing: .1em; color: var(--text-faint); }
  .article-toc ol { margin: 18px 0 0; padding: 0; list-style: none; }
  .article-toc li + li { margin-top: 11px; }
  .article-toc a { color: var(--text-dim); font-size: 13px; line-height: 1.4; }
  .article-toc a:hover { color: var(--accent); }
  .article-body section + section { margin-top: 64px; }
  .article-body h2 { font-size: 28px; letter-spacing: -.035em; }
  .article-body h3 { margin-top: 0; font: 600 12px var(--mono); letter-spacing: .02em; color: var(--text-dim); }
  .article-section-meta { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 8px 18px; margin: 20px 0 26px; padding: 18px 20px; border-left: 3px solid var(--border); background: var(--bg-elev); }
  .article-section-meta dt { font: 600 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--text-faint); }
  .article-section-meta dd { margin: 0; color: var(--text-dim); font-size: 15px; line-height: 1.55; }
  .article-module-list { display: flex; flex-wrap: wrap; gap: 5px 0; }
  .article-module + .article-module { margin-left: .65ch; }
  .article-module-list code { color: var(--text); font: 12px var(--mono); }
  .article-body p code, .article-body li code { padding: .08em .34em; border: 1px solid var(--border); border-radius: 4px; background: var(--code-bg); color: var(--code-keyword); font: 500 .9em/1.45 var(--mono); overflow-wrap: anywhere; }
  .article-body p, .article-body li { color: var(--text-dim); font-size: 17px; line-height: 1.75; }
  .article-body ul { padding-left: 20px; }
  .article-body li { padding-left: 8px; margin: 10px 0; }
  .article-body li::marker { color: var(--accent); }
  .article-summary-block { padding: 28px 30px; border: 1px solid var(--border); background: var(--bg-elev); }
  .article-summary-block h2 { font-size: 22px; }
  .article-summary-block p, .article-summary-block li { font-size: 15px; }
  .article-example { margin-top: 28px; }
  .article-example :global(pre) {
    margin: 10px 0 0;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--code-bg) !important;
    font-size: 13px;
    line-height: 1.65;
  }
  .article-example :global(code) { font-family: var(--mono); }
  .article-next { display: flex; justify-content: space-between; gap: 24px; margin-top: 72px; padding: 24px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); font-size: 14px; }
  .article-next span { color: var(--text-faint); }
  .article-next a { color: var(--accent); font-weight: 700; }
  @media (max-width: 760px) {
    .article-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .article-toc { position: static; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
    .article-next { flex-direction: column; gap: 6px; }
    .article-section-meta { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .article-section-meta dd + dt { margin-top: 10px; }
  }
</style>
