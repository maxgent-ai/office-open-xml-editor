{
  "name": "@maxgent/ooxml-pptx-editor",
  "version": "0.1.0",
  "description": "Optimistic PPTX editor session, mutations, and view binding for @maxgent/ooxml",
  "license": "MIT",
  "author": "Maxgent",
  "keywords": [
    "ooxml",
    "pptx",
    "powerpoint",
    "editor",
    "officecli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxgent-ai/office-open-xml-editor.git",
    "directory": "packages/pptx-editor"
  },
  "homepage": "https://github.com/maxgent-ai/office-open-xml-editor/tree/main/packages/pptx-editor#readme",
  "bugs": {
    "url": "https://github.com/maxgent-ai/office-open-xml-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:officecli-live": "vitest run --config vitest.officecli-live.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@maxgent/ooxml": ">=0.77.0-0"
  },
  "devDependencies": {
    "@maxgent/ooxml": "workspace:*",
    "@types/node": "^25.6.0",
    "rolldown-plugin-dts": "^0.28.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
